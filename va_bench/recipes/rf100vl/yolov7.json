{
  "schema_version": "rf100vl.recipe.v1",
  "family": "yolov7",
  "source": {
    "repository": "https://github.com/LibreYOLO/libreyolo",
    "commit": "89a80a9e3d7263f58ffe5ad1fb06b2d9939c859a",
    "paths": ["libreyolo/training/config.py"],
    "license": "MIT",
    "normalization": "YOLOv7Config family defaults under the RF100-VL fixed skeleton: the YOLOX-style SimOTA pipeline (mosaic+mixup on, degrees 10, shear 2, yoloxwarmcos) with v7's own overrides (momentum 0.937, warmup 3, EMA 0.9999). Single upstream size 'b'. No cuda_graph flag: yolo7 has no training capture spec and no SUPPORTS_CUDA_GRAPH opt-in, so the flag would change nothing."
  },
  "protocol": {
    "epochs": 100,
    "effective_batch": 16,
    "physical_batch": 16,
    "selection_metric": "valid_mAP50_95",
    "eval_interval": 1,
    "patience": 0,
    "ema": true,
    "seed": 0,
    "precision": "fp32",
    "cache": "disk"
  },
  "sizes": {
    "b": {"imgsz": 640, "lr0": 0.01}
  },
  "train": {
    "optimizer": "sgd",
    "momentum": 0.937,
    "weight_decay": 0.0005,
    "nesterov": true,
    "scheduler": "yoloxwarmcos",
    "warmup_epochs": 3,
    "warmup_lr_start": 0.0,
    "no_aug_epochs": 15,
    "min_lr_ratio": 0.05,
    "mosaic_prob": 1.0,
    "mixup_prob": 1.0,
    "hsv_prob": 1.0,
    "flip_prob": 0.5,
    "degrees": 10.0,
    "translate": 0.1,
    "shear": 2.0,
    "ema_decay": 0.9999,
    "workers": 4
  }
}

{
  "schema_version": "rf100vl.recipe.v1",
  "family": "ec",
  "source": {
    "repository": "https://github.com/LibreYOLO/libreyolo",
    "commit": "3e3c9dffc9e4bd41a363f1dd6ca1c736e145a5d8",
    "paths": ["libreyolo/training/config.py"],
    "license": "MIT",
    "normalization": "LibreYOLO EC AdamW/no-mosaic defaults under the RF100-VL fixed skeleton"
  },
  "protocol": {
    "epochs": 100,
    "effective_batch": 16,
    "physical_batch": 8,
    "selection_metric": "valid_mAP50_95",
    "eval_interval": 1,
    "patience": 0,
    "ema": true,
    "seed": 0,
    "precision": "fp32",
    "cache": "disk"
  },
  "sizes": {
    "s": {"imgsz": 640, "lr0": 0.0005},
    "m": {"imgsz": 640, "lr0": 0.0005},
    "l": {"imgsz": 640, "lr0": 0.0005, "backbone_lr_mult": 0.01},
    "x": {"imgsz": 640, "lr0": 0.0005, "backbone_lr_mult": 0.01}
  },
  "train": {
    "optimizer": "adamw",
    "weight_decay": 0.0001,
    "scheduler": "flat_cosine",
    "warmup_epochs": 2,
    "warmup_lr_start": 0.000001,
    "no_aug_epochs": 4,
    "min_lr_ratio": 0.5,
    "mosaic_prob": 0.0,
    "mixup_prob": 0.0,
    "hsv_prob": 0.0,
    "flip_prob": 0.5,
    "degrees": 0.0,
    "translate": 0.0,
    "shear": 0.0,
    "multi_scale": false,
    "backbone_lr_mult": 0.05,
    "clip_max_norm": 0.1,
    "ema_decay": 0.9999,
    "workers": 4
  }
}

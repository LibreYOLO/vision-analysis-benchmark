{
  "schema_version": "rf100vl.recipe.v1",
  "family": "yolov9",
  "source": {
    "repository": "https://github.com/LibreYOLO/libreyolo",
    "commit": "3e3c9dffc9e4bd41a363f1dd6ca1c736e145a5d8",
    "paths": ["tests/e2e/configs/yolo9.yaml", "libreyolo/training/config.py"],
    "license": "MIT",
    "normalization": "RF5 family knobs under the RF100-VL fixed skeleton"
  },
  "protocol": {
    "epochs": 100,
    "effective_batch": 16,
    "physical_batch": 16,
    "selection_metric": "valid_mAP50_95",
    "eval_interval": 1,
    "patience": 0,
    "ema": true,
    "seed": 0,
    "precision": "fp32"
  },
  "sizes": {
    "t": {"imgsz": 640, "lr0": 0.005},
    "s": {"imgsz": 640, "lr0": 0.01},
    "m": {"imgsz": 640, "lr0": 0.01},
    "c": {"imgsz": 640, "lr0": 0.01}
  },
  "train": {
    "optimizer": "sgd",
    "momentum": 0.937,
    "weight_decay": 0.0005,
    "nesterov": true,
    "scheduler": "linear",
    "warmup_epochs": 5,
    "warmup_lr_start": 0.0,
    "no_aug_epochs": 15,
    "min_lr_ratio": 0.05,
    "mosaic_prob": 1.0,
    "mixup_prob": 0.5,
    "hsv_prob": 1.0,
    "flip_prob": 0.5,
    "degrees": 10.0,
    "translate": 0.1,
    "shear": 2.0,
    "ema_decay": 0.9998,
    "workers": 4
  }
}

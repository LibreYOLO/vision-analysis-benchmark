{
  "schema_version": "rf100vl.recipe.v1",
  "family": "yolov9-e2e",
  "source": {
    "repository": "https://github.com/LibreYOLO/libreyolo",
    "commit": "89a80a9e3d7263f58ffe5ad1fb06b2d9939c859a",
    "paths": [
      "libreyolo/training/config.py",
      "libreyolo/models/yolo9_e2e/config.py"
    ],
    "license": "MIT",
    "normalization": "Identical hyperparameters to the yolov9 recipe: YOLO9E2EConfig subclasses YOLO9Config and overrides only the run name (verified at the pinned commit), so the e2e dual-assignment head trains under the exact same MMT-aligned defaults. cuda_graph stays false: training capture is deliberately excluded for the e2e head (YOLO9Trainer.cuda_graph_train_spec requires the plain DDetect head), and graphed validation is withheld until the e2e eval forward passes its own capture-parity check."
  },
  "protocol": {
    "epochs": 100,
    "effective_batch": 16,
    "physical_batch": 16,
    "selection_metric": "valid_mAP50_95",
    "eval_interval": 1,
    "patience": 0,
    "ema": true,
    "seed": 0,
    "precision": "fp32",
    "cuda_graph": false,
    "cache": "disk"
  },
  "sizes": {
    "t": {"imgsz": 640, "lr0": 0.005},
    "s": {"imgsz": 640, "lr0": 0.01},
    "m": {"imgsz": 640, "lr0": 0.01},
    "c": {"imgsz": 640, "lr0": 0.01}
  },
  "train": {
    "save_period": 0,
    "optimizer": "sgd",
    "momentum": 0.937,
    "weight_decay": 0.0005,
    "nesterov": true,
    "scheduler": "linear",
    "warmup_epochs": 3,
    "warmup_lr_start": 0.0001,
    "no_aug_epochs": 15,
    "min_lr_ratio": 0.01,
    "mosaic_prob": 1.0,
    "mixup_prob": 0.0,
    "hsv_prob": 1.0,
    "flip_prob": 0.5,
    "degrees": 0.0,
    "translate": 0.1,
    "shear": 0.0,
    "ema_decay": 0.9999,
    "workers": 4
  }
}
